# Backend API URL (leave empty or use relative "/api" when served together by backend, or point to your deployed backend URL)
# Example for local development:
VITE_API_URL=http://localhost:5000/api

# Example for production (when backend is on Render/Railway and frontend is on Vercel/Netlify):
# VITE_API_URL=https://your-backend-service.onrender.com/api
