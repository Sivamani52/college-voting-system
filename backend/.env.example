# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=production

# Frontend Client URL(s) for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# ==========================================
# Database Configuration (MySQL)
# ==========================================
# Option A: Full Connection URI (Common in Railway, Render, Fly.io, TiDB)
# DATABASE_URL=mysql://user:password@host:port/database?ssl-mode=REQUIRED

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=college_voting
# Set DB_SSL=true when connecting to cloud MySQL providers (Aiven, TiDB, PlanetScale, AWS RDS)
DB_SSL=false

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=1d

# ==========================================
# Brevo (Sendinblue) Email Service
# ==========================================
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=College Voting System
BREVO_SENDER_EMAIL=noreply@example.com
